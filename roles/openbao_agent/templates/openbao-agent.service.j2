[Unit]
Description="Openbao Agent"
Documentation=https://www.openbao.org/
Requires=network-online.target
After=network-online.target

[Service]
User=openbao
Group=openbao
Environment="BAO_SKIP_VERIFY=1"
ExecStart=/usr/bin/bao agent \
        -config=/etc/openbao.d/openbao-agent.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
