#!/bin/bash
export BAO_ADDR={{ openbao_url }}

# Grab the restart approle creds from files
while IFS= read -r line || [[ -n "$line" ]]; do
    export RESTART_ROLE_ID=$line
done < {{ openbao_agent_config_dir }}/restart_role_id
while IFS= read -r line || [[ -n "$line" ]]; do
    export RESTART_SECRET_ID=$line
done < {{ openbao_agent_config_dir }}/restart_secret_id

# Authenticate to Vault with the restart AppRole creds
export BAO_TOKEN=`bao write -field=token auth/approle/login role_id=$RESTART_ROLE_ID secret_id=$RESTART_SECRET_ID`
echo "Restart Token is: $BAO_TOKEN"
bao token lookup
# Write a wrapped secret-id to the same file that the agent expects from its config
bao write -field=wrapping_token -wrap-ttl=200s -f auth/approle/role/agent/secret-id > {{ openbao_agent_config_dir }}/secret_id
# Start the agent
bao agent -config={{ openbao_agent_config_dir }}/openbao-agent.hcl
